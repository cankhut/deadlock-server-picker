  <x:String x:Key="NoServersMatch">Keine Server gefunden</x:String>
  <x:String x:Key="BlockAllToolTip">Alle angezeigten Server blockieren</x:String>
  <x:String x:Key="UnblockAllToolTip">Alle Firewallregeln entfernen</x:String>
  <x:String x:Key="AllowedColumnHeader">Erlaubt</x:String>
  <x:String x:Key="PresetAllowAll">Alle</x:String>
  <x:String x:Key="PresetAllowNone">Keine</x:String>
  <x:String x:Key="PresetAllowAllToolTip">Alle Server dieser Voreinstellung erlauben</x:String>
  <x:String x:Key="PresetAllowNoneToolTip">Alle Server dieser Voreinstellung blockieren</x:String>
  <x:String x:Key="BlockSlowerMenuItem">Server ab dieser Latenz sperren</x:String>
  <x:String x:Key="AutoRefreshLabel">Auto-Aktualisierung</x:String>
  <x:String x:Key="AutoRefreshToolTip">Nicht gesperrte Server regelmäßig neu messen</x:String>
  <x:String x:Key="AutoRefreshOff">Aus</x:String>
  <x:String x:Key="AutoRefresh5">Alle 5 Minuten</x:String>
  <x:String x:Key="AutoRefresh15">Alle 15 Minuten</x:String>
  <x:String x:Key="AutoRefresh30">Alle 30 Minuten</x:String>
  <x:String x:Key="MinimizeToTrayLabel">Beim Schließen in den Infobereich</x:String>
  <x:String x:Key="MinimizeToTrayToolTip">Beim Schließen des Fensters läuft die App im Infobereich weiter</x:String>
  <x:String x:Key="TrayShow">Anzeigen</x:String>
  <x:String x:Key="TrayQuit">Beenden</x:String>
  <x:String x:Key="PresetShare">Teilen</x:String>
  <x:String x:Key="PresetShareToolTip">Teilcode für die gewählte Voreinstellung kopieren</x:String>
  <x:String x:Key="PresetImport">Importieren</x:String>
  <x:String x:Key="PresetImportToolTip">Voreinstellung aus einem Teilcode in der Zwischenablage hinzufügen</x:String>
  <x:String x:Key="PresetCodeCopiedDialogue">Teilcode in die Zwischenablage kopiert.</x:String>
  <x:String x:Key="PresetImportedDialogue">Voreinstellung importiert.</x:String>
  <x:String x:Key="PresetImportWrongGameDialogue">Dieser Code gehört zu einem anderen Spiel. Wechsle das Spiel und versuche es erneut.</x:String>
  <x:String x:Key="PresetImportInvalidDialogue">Kein gültiger Teilcode in der Zwischenablage gefunden.</x:String>
  <x:String x:Key="BlockedOnExitDialogue">{0} Server sind weiterhin gesperrt. Die Firewallregeln bleiben nach dem Schließen bestehen, diese Server bleiben also gesperrt, bis du sie hier freigibst.</x:String>
  <x:String x:Key="BlockedOnExitUnblock">Alle freigeben und schließen</x:String>
  <x:String x:Key="BlockedOnExitKeep">Trotzdem schließen</x:String>
  <x:String x:Key="BlockedOnExitCancel">Abbrechen</x:String>
  <x:String x:Key="RenderMode">Render-Modus:</x:String>
  <x:String x:Key="RenderModeToolTip">Ändern Sie die Art und Weise, wie die App auf dem Bildschirm gerendert wird, indem Sie eine andere Grafik-Pipeline verwenden.</x:String>
  <x:String x:Key="RenderModeDialogue">Starten Sie die Anwendung neu, damit die Änderungen wirksam werden.</x:String>
  <x:String x:Key="AutoApplyOnGameLaunchLabel">Voreinstellung beim Spielstart anwenden</x:String>
  <x:String x:Key="AutoApplyOnGameLaunchToolTip">Wendet beim Spielstart die zuletzt genutzte Voreinstellung dieses Spiels an und hebt beim Beenden alle Sperren wieder auf</x:String>
  <x:String x:Key="StatusPlaying">spielen</x:String>
  <x:String x:Key="PlayerCountToolTip">Spielen dieses Spiel gerade, weltweit, laut Steam</x:String>
  <x:String x:Key="LateNightNoticeDialogue">Bei dir ist es spät, deshalb spielen in deiner Nähe weniger Leute. Wenn die meisten Server gesperrt sind, kann die Spielersuche länger dauern. Das ist normal und liegt nicht an der App. Wenn die Warteschlange zu lang wird, gib ein paar Server in deiner Nähe frei.</x:String>
  <x:String x:Key="DontShowAgain">Nicht mehr anzeigen</x:String>
  <x:String x:Key="OkDontAskAgain">Ok, nicht mehr fragen</x:String>
  <x:String x:Key="ShowHiddenNotices">Hinweise wieder anzeigen</x:String>
  <x:String x:Key="ShowHiddenNoticesToolTip">Alle ausgeblendeten Hinweise wieder anzeigen</x:String>
</ResourceDictionary>
